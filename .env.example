# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Opcional: endereço público do app (usado nos links enviados aos clientes).
# Se vazio, usa o domínio de onde o painel está aberto.
NEXT_PUBLIC_SITE_URL=

# Opcional: limite por arquivo exibido no envio (o padrão do Supabase Free é 50 MB).
NEXT_PUBLIC_MAX_UPLOAD_MB=50

# Opcional, SOMENTE servidor: permite adicionar/remover pessoas da equipe pelo
# painel (/dashboard/equipe). Nunca use prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Agendamento: aviso por e-mail quando o cliente aprova ----
# Obrigatório para os avisos: o servidor lê a fila de avisos com esta chave.
# (a mesma SUPABASE_SERVICE_ROLE_KEY acima)
# Resend → API Keys
RESEND_API_KEY=
# Remetente de um domínio verificado na Resend, ex.: Aguiar&Co Aprova <aprova@aguiareco.com.br>
NOTIFY_EMAIL_FROM=
# Quem recebe (separe vários com vírgula)
SCHEDULER_EMAIL=
# Senha longa e aleatória; o MESMO valor vai no Vault do Supabase (notify_webhook_secret)
NOTIFY_WEBHOOK_SECRET=
